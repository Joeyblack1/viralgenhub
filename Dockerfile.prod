# ViralGenHub production image (multi-stage).
#
# Same runtime as upstream's Dockerfile.dev (left untouched so upstream merges
# stay easy): nginx on :5000 in front of pm2 running frontend (Next.js, :4200),
# backend (Nest, :3000) and orchestrator (Temporal worker), started with the
# same command (`nginx && pnpm run pm2`, which runs `prisma db push` first).
#
# What makes it smaller:
#   - compilers (g++, make, python3) stay in the builder stage
#   - devDependencies are dropped: node_modules is reinstalled with --prod
#     after the build (native modules such as bcrypt are built in the builder
#     and copied over in built form)
#   - the pnpm store, npm cache and Next.js build cache (.next/cache) are not
#     copied into the runtime stage

ARG NODE_IMAGE=node:22.20-bookworm-slim

# ---------------------------------------------------------------- builder ---
FROM ${NODE_IMAGE} AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
&& rm -rf /var/lib/apt/lists/*

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1

WORKDIR /app
COPY . /app

RUN pnpm install

ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# Production dependencies only, installed from the store the first install
# filled (same lockfile, so the same versions the build used). postinstall
# re-runs `prisma generate`, so node_modules/.prisma/client is regenerated.
RUN rm -rf node_modules apps/*/node_modules libraries/*/node_modules \
       apps/frontend/.next/cache \
 && pnpm install --prod --frozen-lockfile --prefer-offline \
 && rm -rf node_modules/.cache

# Delete files the running app never loads (about 1.4 GB):
#  1. musl builds of native packages (this image is Debian/glibc)
#  2. Temporal core-bridge binaries for other platforms (it ships five)
#  3. source maps (node only reads them with --enable-source-maps, which is
#     not used; `next start` does not enable them either)
#  4. TypeScript declaration files (kept inside any typescript/ package, in
#     case something compiles TypeScript at runtime)
RUN set -eux; \
    find node_modules -regextype posix-extended -type d \
      -regex '(.*/)?node_modules/(@[^/]+/)?[^/]*musl[^/]*' -prune -exec rm -rf {} +; \
    keep="$(uname -m)-unknown-linux-gnu"; \
    for d in node_modules/@temporalio/core-bridge/releases/*/; do \
      [ "$(basename "$d")" = "$keep" ] || rm -rf "$d"; \
    done; \
    test -f "node_modules/@temporalio/core-bridge/releases/$keep/index.node"; \
    find node_modules apps/frontend/.next -type f \( \
      -name '*.js.map' -o -name '*.mjs.map' -o -name '*.cjs.map' \
      -o -name '*.jsx.map' -o -name '*.css.map' \
      -o -name '*.ts.map' -o -name '*.mts.map' -o -name '*.cts.map' -o -name '*.tsx.map' \
    \) -delete; \
    find node_modules -type f \( -name '*.d.ts' -o -name '*.d.mts' -o -name '*.d.cts' \) \
      -not -path '*/typescript/*' -delete

# ---------------------------------------------------------------- runtime ---
FROM ${NODE_IMAGE} AS runtime

# openssl + ca-certificates: Prisma needs libssl at runtime (the dev image got
# them indirectly through python3-pip).
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    bash \
    ca-certificates \
    openssl \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2 \
 && npm cache clean --force

WORKDIR /app

COPY --from=builder /app /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

# Warm the `pnpm dlx prisma@6.5.0` cache used by `pnpm run prisma-db-push` at
# start, as the dev image's build left it warm. pnpm treats the dlx cache as
# fresh for 24h; after that the start re-downloads prisma (needs the npm
# registry), exactly like the dev image.
# The registry metadata cache is only needed to resolve, not to reuse the
# cached install, so it is dropped (about 90 MB).
RUN (pnpm dlx prisma@6.5.0 version || true) \
 && rm -rf /root/.cache/pnpm/metadata*

ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION

CMD ["sh", "-c", "nginx && pnpm run pm2"]
