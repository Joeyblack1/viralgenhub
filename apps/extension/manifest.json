{
  "manifest_version": 3,
  "name": "ViralGenHub",
  "version": "1.0.1",
  "description": "Connects your Skool account to ViralGenHub so you can schedule Skool posts from the app. Only works with viralgenhub.com.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "cookies",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.skool.com/*",
    "https://app.viralgenhub.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://app.viralgenhub.com/*"
    ]
  }
}
