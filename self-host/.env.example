# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.

# Image tag: a release tag (see https://github.com/ViralGenHub/viralgenhub/releases)
VGH_TAG=vgh-1.0.0

# The address people open in the browser, no trailing slash.
# Trying it on this machine: http://localhost:4007 (and keep NOT_SECURED=true).
# On a server behind a reverse proxy with https: https://social.example.com (and delete NOT_SECURED).
VGH_URL=http://localhost:4007
NOT_SECURED=true
VGH_PORT=4007
# 127.0.0.1 = only this machine / your reverse proxy can reach the port. 0.0.0.0 = everyone on the network.
VGH_BIND=127.0.0.1

# Secrets: generate each one with the command in the comment above it and paste the output.
# (Or run the one-liner in INSTALL.md step 3, which fills all four.)
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 16
POSTGRES_PASSWORD=
# openssl rand -hex 16
TEMPORAL_DB_PASSWORD=
# openssl rand -base64 32   (set before connecting accounts; keep a backup: lose it and saved accounts must be reconnected)
TOKEN_ENCRYPTION_KEY=

# After you have created your own account, set this to true so strangers can't sign up.
DISABLE_REGISTRATION=false

# Email (optional): resend or nodemailer. Leave empty for no emails.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=

# Platforms: add the keys of your own developer apps, e.g.
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# MASTODON_URL=https://mastodon.social
# MASTODON_CLIENT_ID=
# MASTODON_CLIENT_SECRET=
# The full list of variable names is in docker-compose.yml.
